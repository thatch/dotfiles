#!/usr/bin/env bash
# Keep setup changes out of the calling shell when sourced.
(
    umask 077
    mkdir -p "$HOME/.ssh" &&
        ssh-agent > "$HOME/.ssh/agent-config.sh" &&
        chmod 600 "$HOME/.ssh/agent-config.sh"
) &&
    . "$HOME/.ssh/agent-config.sh" &&
    ssh-add "$HOME/.ssh/id_rsa" "$HOME/.ssh/id_rsa_github"
